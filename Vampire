-- 3. ล่องหน (Invisible)
createButton("ล่องหน (Invisibility)", function(state)
	_G.InvisEnabled = state
	local char = LocalPlayer.Character
	if not char then return end
	for _, part in pairs(char:GetDescendants()) do
		if part:IsA("BasePart") or part:IsA("Decal") then
			part.Transparency = _G.InvisEnabled and 1 or (part.Name == "HumanoidRootPart" and 1 or 0)
		end
	end
end)

-- 4. โดดแดด/ฝน (กันแดดกันฝนแวมไพร์)
createButton("กันแดด / ฝน แวมไพร์", function(state)
	_G.SunRainProof = state
	task.spawn(function()
		while _G.SunRainProof do
			task.wait(0.5)
			local char = LocalPlayer.Character
			if char then
				-- ลบเอฟเฟกต์แดด/ฝน/ดีบัฟที่แมพใส่ให้แวมไพร์ (ถ้ามีอยู่ในตัวละคร)
				for _, v in pairs(char:GetChildren()) do
					if v:IsA("Script") or v:IsA("LocalScript") then
						if v.Name:lower():find("burn") or v.Name:lower():find("sun") or v.Name:lower():find("rain") or v.Name:lower():find("damage") then
							v.Disabled = true
						end
					end
				end
			end
		end
	end)
end)

-- 5. บิน (Fly)
createTextBox("ความเร็วบิน (Fly Speed)", 50, function(val)
	_G.FlySpeedVal = val
end)

createButton("ระบบบิน (Fly)", function(state)
	_G.IsFlying = state
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local rootPart = char.HumanoidRootPart
	
	if _G.IsFlying then
		local bv = Instance.new("BodyVelocity")
		bv.Name = "MobileFlyVelocity"
		bv.Parent = rootPart
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bv.Velocity = Vector3.new(0, 0, 0)
		
		task.spawn(function()
			while _G.IsFlying do
				task.wait()
				local moveDir = Camera.CFrame.LookVector
				local vel = Vector3.new(0, 0, 0)
				if UserInputService:IsKeyDown(Enum.KeyCode.W) or true then -- บนมือถืออาศัยทิศทางกล้องหลัก
					vel = Camera.CFrame.LookVector * _G.FlySpeedVal
				end
				bv.Velocity = vel
			end
			if bv then bv:Destroy() end
		end)
	else
		if rootPart:FindFirstChild("MobileFlyVelocity") then
			rootPart.MobileFlyVelocity:Destroy()
		end
	end
end)

-- 6. ออมตะ / โดนตีเลือดไม่ลด (Godmode สำหรับแวมไพร์)
createButton("อมตะเลือดไม่ลด", function(state)
	_G.GodModeEnabled = state
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("Humanoid") then
		char.Humanoid.BreakJointsOnDeath = not _G.GodModeEnabled
		char.Humanoid.HealthChanged:Connect(function(health)
			if _G.GodModeEnabled and health < char.Humanoid.MaxHealth then
				char.Humanoid.Health = char.Humanoid.MaxHealth
			end
		end)
	end
end)

-- 7. เดินบนกำแพง (Wall Walk)
createButton("เดินบนกำแพง (Wall Walk)", function(state)
	_G.WallWalkEnabled = state
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local rootPart = char.HumanoidRootPart
	
	task.spawn(function()
		while _G.WallWalkEnabled do
			task.wait(0.1)
			local ray = Ray.new(rootPart.Position, rootPart.CFrame.LookVector * 3)
			local hit = Workspace:FindPartOnRay(ray, char)
			if hit then
				rootPart.Velocity = Vector3.new(0, 10, 0)
			end
		end
	end)
end)

-- 8. วาร์ปไปหาคนใกล้ที่สุด
createActionButton("วาร์ปหาคนใกล้สุด", function()
	local targetPlayer = nil
	local shortestDistance = math.huge
	local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	
	if not myRoot then return end
	
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local dist = (myRoot.Position - player.Character.HumanoidRootPart.Position).Magnitude
			if dist < shortestDistance then
				shortestDistance = dist
				targetPlayer = player
			end
		end
	end
	
	if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
		myRoot.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
	end
end)
